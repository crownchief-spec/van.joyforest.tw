/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/images/og/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=2592000

/assets/css/*
  Cache-Control: public, max-age=604800

/assets/css/style.css
  Cache-Control: public, max-age=300

/assets/js/*
  Cache-Control: public, max-age=604800

/assets/js/main.js
  Cache-Control: public, max-age=300

/assets/js/campervan-availability.js
  Cache-Control: public, max-age=300

/assets/js/booking-inquiry.js
  Cache-Control: public, max-age=300

/assets/data/campervan-availability.json
  Cache-Control: no-cache, max-age=0, must-revalidate

/api/campervan-availability
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/pages/e-sign-contract.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=()

/pages/e-sign-contract-today*
  Cache-Control: private, no-store, no-cache, must-revalidate, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=()

/api/e-sign-contract-today
  Cache-Control: private, no-store, no-cache, must-revalidate, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
